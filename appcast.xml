        <item>
            <title>1.3.7</title>
            <pubDate>Sat, 31 Oct 2026 14:42:19 +0530</pubDate>
            <sparkle:version>29</sparkle:version>
            <sparkle:shortVersionString>1.3.7</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <description sparkle:format="markdown"><![CDATA[- A new icon: cars crossing a bridge that stands on the Alt and ⌥ keys, with a simpler version for small sizes
- The cars drive across the logo in the menu-bar panel, Settings › About and the welcome window
- A new menu-bar icon to match: its keys fill while you type a sequence in Excel, and a little car crosses when the shortcut runs
]]></description>
            <enclosure url="https://raw.githubusercontent.com/kushagragupta126/altbridge-updates/main/archives/AltBridge-1.3.7.zip" length="3061327" type="application/octet-stream" sparkle:edSignature="iCm02ICEovdTibNxnm3h66aCC0O5XMewpcFJEnb2eSRBPYhC560rihtW4xTdDrPWLdKnGf/J8vfDoSxmJ1VjDw=="/>
