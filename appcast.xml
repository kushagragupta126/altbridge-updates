        <item>
            <title>1.3.6</title>
            <pubDate>Wed, 28 Oct 2026 23:53:14 +0530</pubDate>
            <sparkle:version>28</sparkle:version>
            <sparkle:shortVersionString>1.3.6</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <description sparkle:format="markdown"><![CDATA[- Notices fit their whole message and sit just above the sheet tabs of the Excel window you're using, wherever it is
- Settings no longer shifts sideways when you open Learning Hints
- Lighter on Excel: clicking in your sheet no longer makes AltBridge ask Excel anything (learning hints only look at ribbon and menu clicks)
]]></description>
            <enclosure url="https://raw.githubusercontent.com/kushagragupta126/altbridge-updates/main/archives/AltBridge-1.3.6.zip" length="2873975" type="application/octet-stream" sparkle:edSignature="NBnDPJJ9HDks4lD6X1GTpNbxzUtiR8idvSFakXNZIfxmlcmJ2b+He1rIKll1IkQwHAdsDEWYO1A3/r6uEtYhAw=="/>
        </item>
        <item>
            <title>1.3.5</title>
            <pubDate>Wed, 28 Oct 2026 23:34:24 +0530</pubDate>
            <sparkle:version>27</sparkle:version>
            <sparkle:shortVersionString>1.3.5</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <description sparkle:format="markdown"><![CDATA[- AltBridge keeps hearing your keys after your Mac has sat idle, slept or locked for hours: it no longer naps, and it restarts its keyboard listener after wake and unlock
- If macOS Secure Input is hiding your keys (often left on after unlocking), AltBridge now says so and how to clear it
]]></description>
            <enclosure url="https://raw.githubusercontent.com/kushagragupta126/altbridge-updates/main/archives/AltBridge-1.3.5.zip" length="2868528" type="application/octet-stream" sparkle:edSignature="QlaeTU0B7Ml+z8Qapdq0sqL7bgqna+Fk0iTE3bYAxfAbAnP6ZGm4Oh3Uwz4UEV/FnZyCRJWlzs5X1zME4U4RDQ=="/>
        </item>
